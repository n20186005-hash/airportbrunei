---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Halaman tidak ditemui — Panduan BWN" description="Halaman yang diminta tidak ditemui." hideNav={true}>
  <section class="section-shell flex min-h-[58vh] flex-col items-start justify-center py-20">
    <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-emerald-brunei">Ralat 404</p>
    <h1 class="mt-3 font-display text-5xl font-bold text-emerald-deep sm:text-7xl">Halaman tidak ditemui</h1>
    <p class="mt-5 max-w-xl text-base leading-8 text-ink/65">Alamat mungkin berubah atau halaman tidak lagi tersedia. Kembali ke panduan utama untuk maklumat Lapangan Terbang Antarabangsa Brunei.</p>
    <a href="/" class="mt-7 rounded-full bg-emerald-deep px-5 py-3 text-sm font-extrabold text-white hover:bg-emerald-brunei">Kembali ke laman utama</a>
  </section>
</BaseLayout>
