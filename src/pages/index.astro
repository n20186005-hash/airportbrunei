---
import BaseLayout from '../layouts/BaseLayout.astro';
import { officialSources, siteInfo } from '../data/site';

const title = 'Lapangan Terbang Antarabangsa Brunei (BWN) — Lokasi & Penerbangan';
const description = 'Panduan bebas Brunei International Airport (BWN): lokasi Bandar Seri Begawan, pautan rasmi ketibaan dan berlepas, pengangkutan serta perkara yang perlu disahkan sebelum perjalanan.';
const canonical = Astro.site ? new URL('/', Astro.site).href : undefined;
const heroImage = Astro.site ? new URL('/images/bwn-hero.webp', Astro.site).href : undefined;

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'Airport',
  name: siteInfo.placeName,
  alternateName: 'Brunei International Airport (BWN)',
  description,
  ...(canonical ? { url: canonical } : {}),
  ...(heroImage ? { image: heroImage } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Lapangan Terbang Antarabangsa Brunei',
    addressLocality: 'Bandar Seri Begawan',
    postalCode: 'BB2513',
    addressCountry: 'BN'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteInfo.latitude,
    longitude: siteInfo.longitude
  },
  telephone: siteInfo.phoneOfficial,
  email: siteInfo.emailOfficial
};

const faqItems = [
 {q:'Di manakah Lapangan Terbang Antarabangsa Brunei (BWN)?',a:'BWN terletak di Bandar Seri Begawan, Brunei Darussalam, BB2513. Pin Google Maps disemak pada 20 Oktober 2026 ialah 4.9448545, 114.934508; pin ini rujukan lokasi, bukan arahan ke pintu atau zon pengambilan tertentu.'},
 {q:'Di manakah saya boleh menyemak ketibaan dan berlepas BWN?',a:'Buka halaman Flight Information Jabatan Penerbangan Awam dan sahkan juga dengan syarikat penerbangan. Panduan ini tidak memaparkan status langsung, pintu berlepas atau masa daftar masuk.'},
 {q:'Adakah semua kemudahan lapangan terbang dibuka 24 jam?',a:'Waktu untuk seluruh lapangan terbang tidak dipaparkan dalam semakan Maps pada 20 Oktober 2026. Waktu kaunter, kedai, ruang rehat dan akses terminal boleh berbeza; sahkan perkhidmatan yang anda perlukan dengan DCA atau syarikat penerbangan.'},
 {q:'Bolehkah orang bukan penumpang masuk atau menyambut ketibaan?',a:'Jangan anggap semua ruang terminal terbuka kepada orang bukan penumpang. Sahkan aturan menghantar, menyambut dan zon pengambilan semasa dengan DCA; dokumen SOP lama pada laman rasmi tidak semestinya dasar semasa.'},
 {q:'Bagaimana hendak merancang pengangkutan dan parkir?',a:'Sahkan pilihan pengangkutan yang beroperasi pada waktu ketibaan anda, tempat ambil yang dibenarkan, jumlah tambang serta kadar dan tempoh parkir. Kami tidak mengesahkan jadual bas, ketersediaan teksi atau harga semasa.'},
 {q:'Berapa awal saya patut tiba dan dokumen apa diperlukan?',a:'Ikut masa daftar masuk dan senarai dokumen daripada syarikat penerbangan serta pihak imigresen yang berkenaan. Keperluan bergantung pada perjalanan anda; halaman ini tidak memberikan kelayakan visa atau jaminan masuk.'},
 {q:'Adakah laman ini laman rasmi lapangan terbang?',a:'Tidak. Ini panduan bebas. Untuk operasi, penerbangan dan bantuan, gunakan Jabatan Penerbangan Awam atau syarikat penerbangan; jangan menghantar dokumen perjalanan atau pertanyaan operasi kepada laman ini.'}
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const facilityCards = [
 ['Tandas & akses', 'Tanya petugas tentang lokasi tandas, laluan tanpa tangga dan bantuan yang sesuai. Tanda akses pada peta tidak mengesahkan setiap laluan terminal.'],
 ['Ruang solat', 'Sahkan lokasi, akses dan waktu penggunaan dengan petugas. Foto arkib tidak membuktikan kemudahan sedang dibuka.'],
 ['Makanan & minuman', 'Sahkan kedai yang beroperasi pada waktu perjalanan anda serta keperluan diet sebelum membeli.'],
 ['ATM & urusan wang', 'Semak mesin, mata wang, caj dan waktu perkhidmatan yang tersedia; kami tidak menjamin ATM atau bank beroperasi sepanjang masa.'],
 ['Bantuan perubatan', 'Jika memerlukan bantuan di terminal, maklumkan petugas dan ikut arahan mereka.'],
 ['Bantuan penumpang', 'Hubungi syarikat penerbangan sebelum perjalanan untuk bantuan khas dan sahkan titik pertemuan.'],
 ['Wi-Fi & sambungan', 'Sahkan rangkaian serta syarat penggunaan di lokasi; sediakan sambungan sandaran untuk maklumat penting.'],
 ['Bagasi', 'Ikut arahan syarikat penerbangan untuk bagasi, tuntutan dan barang yang dibenarkan.']
];

const nearbyAttractions = [
 ['Masjid Omar ‘Ali Saifuddien', 'Calon lawatan bandar yang berasingan; sahkan lokasi, aturan lawatan dan waktu semasa melalui pengendali.'],
 ['Muzium Alat Kebesaran Diraja', 'Calon lawatan berasingan; semak sumber muzium untuk waktu dan syarat masuk sebelum bergerak.'],
 ['Kampong Ayer', 'Calon perjalanan bandar; semak laluan dan perkhidmatan pengangkutan secara berasingan.']
];

---
<BaseLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <section class="relative isolate min-h-[78vh] overflow-hidden bg-emerald-deep text-white">
    <img src="/images/bwn-hero.webp" width="1920" height="1280" alt="Bangunan terminal Lapangan Terbang Antarabangsa Brunei" class="absolute inset-0 h-full w-full object-cover object-center" fetchpriority="high" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(3,35,29,.94)_0%,rgba(3,35,29,.78)_38%,rgba(3,35,29,.28)_74%,rgba(3,35,29,.42)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-emerald-deep/65 to-transparent"></div>
    <div class="section-shell relative flex min-h-[78vh] items-end py-14 sm:items-center sm:py-20">
      <div class="max-w-3xl">
        <div class="mb-5 flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-gold-soft">
          <span class="rounded-full border border-gold-soft/50 bg-emerald-deep/40 px-3 py-2">BWN · WBSB</span>
          <span class="rounded-full border border-white/25 bg-emerald-deep/40 px-3 py-2">Bandar Seri Begawan · BB2513</span>
        </div>
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-white/74">Pintu masuk udara utama Negara Brunei Darussalam</p>
        <h1 class="mt-4 font-display text-5xl font-bold leading-[0.98] tracking-tight sm:text-7xl">Lapangan Terbang Antarabangsa Brunei</h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-white/82 sm:text-lg">
          Bukan sekadar tempat berlepas dan tiba: BWN ialah titik pertama untuk memahami skala Bandar Seri Begawan, budaya layanan Brunei dan rangka perjalanan ke ibu negara. Panduan ini menggabungkan sejarah, orientasi terminal, pengangkutan dan konteks pelawat tanpa promosi komersial.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#panduan" class="rounded-full bg-gold-brunei px-5 py-3 text-sm font-extrabold text-emerald-deep hover:bg-gold-soft">Mulakan panduan</a>
          <a href="#peta" class="rounded-full border border-white/35 bg-black/10 px-5 py-3 text-sm font-bold text-white hover:border-white/70">Peta & lokasi</a>
        </div>
      </div>
    </div>
    <div class="hero-photo-credit absolute bottom-14 right-4 rounded-full bg-black/45 px-3 py-1.5 text-[11px] text-white/75 backdrop-blur">Foto rujukan 2023: Pangalau · CC BY-SA 4.0 · <a href="#kredit-imej">Sumber & lesen</a></div>
  </section>

  <section aria-label="Fakta pantas" class="facts-section relative z-10 -mt-7">
    <div class="section-shell grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {[
        ['Penerbangan', 'Semak DCA', 'Ketibaan dan berlepas melalui pautan rasmi'],
        ['Lokasi', 'Bandar Seri Begawan', 'Pin Maps disemak 20 Oktober 2026'],
        ['Kod lapangan terbang', 'BWN / WBSB', 'IATA / ICAO'],
        ['Jenis panduan', 'Bebas & bukan untung', 'Tiada syor komersial berbayar']
      ].map(([label, value, note]) => (
        <article class="glass card-shadow rounded-2xl border border-white/55 p-5">
          <p class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-emerald-brunei/65">{label}</p>
          <p class="mt-2 text-2xl font-extrabold text-emerald-deep">{value}</p>
          <p class="mt-1 text-xs leading-5 text-ink/58">{note}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="sejarah" class="section-shell py-20 sm:py-28">
    <div class="grid items-start gap-10 lg:grid-cols-[0.86fr_1.14fr]">
      <div class="lg:sticky lg:top-28">
        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-emerald-brunei">Konteks sejarah</p>
        <h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-emerald-deep sm:text-5xl">Daripada Berakas kepada gerbang antarabangsa</h2>
        <p class="mt-5 text-base leading-8 text-ink/72">
          Rekod Jabatan Penerbangan Awam menelusuri aktiviti penerbangan Brunei di Berakas sejak 1953. DCA menerangkan perkembangan kemudahan terminal, radar dan perkhidmatan trafik udara sepanjang beberapa dekad; sejarah ini bukan rekod ketersediaan kemudahan hari ini.
        </p>
        <p class="mt-4 text-sm leading-7 text-ink/60">
          Kami tidak menemui legenda rakyat yang boleh disahkan khusus tentang terminal ini; oleh itu bahagian ini mengutamakan sejarah penerbangan yang mempunyai sumber, bukannya mencipta cerita atau mitos.
        </p>
      </div>
      <div class="relative border-l border-emerald-brunei/18 pl-7 sm:pl-10">
        {[
          ['1953', 'Permulaan era Berakas', 'Catatan sejarah kawalan trafik udara Brunei menyebut aktiviti penerbangan bermula dari landasan lama di Berakas.'],
          ['Perkembangan', 'Kemudahan dan perkhidmatan', 'DCA merekodkan pengembangan terminal, aerobridge dan sistem navigasi sepanjang sejarahnya; semak operasi hari ini secara berasingan.']
        ].map(([year, heading, copy]) => (
          <article class="relative mb-9 rounded-2xl border border-emerald-brunei/12 bg-white/68 p-6 card-shadow">
            <span class="absolute -left-[2.28rem] top-7 h-3.5 w-3.5 rounded-full border-4 border-ivory bg-gold-brunei sm:-left-[2.98rem]"></span>
            <p class="text-sm font-black tracking-[0.16em] text-gold-brunei">{year}</p>
            <h3 class="mt-1 text-xl font-extrabold text-emerald-deep">{heading}</h3>
            <p class="mt-2 text-sm leading-7 text-ink/68">{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-emerald-deep text-white">
    <div class="section-shell grid items-stretch gap-0 lg:grid-cols-2">
      <div class="py-14 pr-0 sm:py-20 lg:pr-12">
        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-gold-soft">Ruang & identiti</p>
        <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">Terminal sebagai muka pertama Brunei</h2>
        <p class="mt-5 max-w-xl text-base leading-8 text-white/72">
          Seni bina terminal menyeimbangkan keperluan pergerakan penumpang dengan bahasa visual setempat. Nada hijau gelap dan emas pada laman ini mengambil inspirasi secara abstrak daripada lanskap, unsur diraja dan seni bina Brunei tanpa meniru identiti rasmi kerajaan.
        </p>
        <div class="mt-8 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-2xl border border-white/12 bg-white/6 p-4"><strong class="block text-gold-soft">Orientasi</strong><span class="mt-1 block text-white/65">Ketibaan · berlepas · imigresen · bagasi</span></div>
          <div class="rounded-2xl border border-white/12 bg-white/6 p-4"><strong class="block text-gold-soft">Adab</strong><span class="mt-1 block text-white/65">Berpakaian sopan dan hormati ruang ibadah</span></div>
        </div>
      </div>
      <figure class="relative min-h-[420px] lg:min-h-full">
        <img src="/images/bwn-sunset.webp" width="1600" height="1067" alt="Ruang terminal Lapangan Terbang Antarabangsa Brunei pada waktu senja" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
        <figcaption class="absolute bottom-4 right-4 rounded-full bg-black/50 px-3 py-1.5 text-[11px] text-white/78">Foto rujukan 2018: Iqbal Selamat · CC BY 2.0 · <a href="#kredit-imej">Sumber & lesen</a></figcaption>
      </figure>
    </div>
  </section>

  <section id="panduan" class="section-shell py-20 sm:py-28">
    <div class="max-w-3xl">
      <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-emerald-brunei">Sebelum anda tiba</p>
      <h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-emerald-deep sm:text-5xl">Panduan pelawat yang praktikal, tanpa promosi</h2>
      <p class="mt-5 text-base leading-8 text-ink/70">Maklumat operasi boleh berubah mengikut penerbangan, keselamatan, cuti dan dasar semasa. Gunakan bahagian ini untuk merancang, kemudian sahkan perkara kritikal melalui sumber rasmi.</p>
    </div>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      <article class="rounded-3xl bg-emerald-deep p-7 text-white lg:col-span-2">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-gold-soft">Tiket / bayaran</span>
        <h3 class="mt-3 text-2xl font-extrabold">Sahkan akses dan caj perkhidmatan</h3>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-white/70">Akses terminal tertakluk pada arahan keselamatan dan kelayakan perjalanan. Semak aturan untuk orang bukan penumpang; caj parkir, pengangkutan dan perkhidmatan pilihan perlu disahkan secara berasingan.</p>
      </article>
      <article class="rounded-3xl border border-gold-brunei/35 bg-gold-soft/28 p-7">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-brunei">Masa terbaik</span>
        <h3 class="mt-3 text-2xl font-extrabold text-emerald-deep">Ikut jadual penerbangan, bukan “waktu tarikan”</h3>
        <p class="mt-3 text-sm leading-7 text-ink/65">Sahkan akses orang bukan penumpang sebelum datang. Peruntukkan masa menurut arahan syarikat penerbangan dan keadaan perjalanan anda.</p>
      </article>
      <article class="rounded-3xl border border-emerald-brunei/12 bg-white/70 p-7 card-shadow">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-brunei">Tempoh</span>
        <h3 class="mt-3 text-xl font-extrabold text-emerald-deep">Ikut masa daftar masuk syarikat penerbangan</h3>
        <p class="mt-3 text-sm leading-7 text-ink/65">Ikut waktu daftar masuk dan waktu tutup kaunter yang ditetapkan syarikat penerbangan. Sediakan masa untuk bagasi, keselamatan dan imigresen mengikut arahan perjalanan anda.</p>
      </article>
      <article class="rounded-3xl border border-emerald-brunei/12 bg-white/70 p-7 card-shadow lg:col-span-2">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-brunei">Etika & budaya</span>
        <h3 class="mt-3 text-xl font-extrabold text-emerald-deep">Ruang awam yang berfungsi, dalam konteks masyarakat Brunei</h3>
        <p class="mt-3 text-sm leading-7 text-ink/65">Hormati arahan keselamatan, elakkan mengambil gambar di kawasan pemeriksaan atau individu tanpa izin, gunakan pakaian sopan dan jaga ketenangan berhampiran ruang ibadah. Pada bulan Ramadan atau waktu solat, sesetengah corak perkhidmatan boleh berbeza.</p>
      </article>
    </div>
  </section>

  <section id="pengangkutan" class="airport-grid border-y border-emerald-brunei/10 bg-white/55 py-20 sm:py-28">
    <div class="section-shell">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-emerald-brunei">Pengangkutan terperinci</p>
          <h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-emerald-deep sm:text-5xl">Dari BWN ke Bandar Seri Begawan — dan kembali</h2>
          <p class="mt-5 text-base leading-8 text-ink/68">Rancang laluan ke alamat akhir anda menggunakan peta dan penyedia pengangkutan. Tempoh perjalanan bergantung pada lokasi, trafik dan zon pengambilan; kami tidak mengesahkan masa atau tambang tetap.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {[
            ['✈', 'Dari penerbangan', 'Selepas imigresen dan tuntutan bagasi, ikuti papan tanda ke balai ketibaan dan zon pengambilan. Sediakan alamat destinasi sebelum keluar terminal.'],
            ['▣', 'Bas awam', 'Jika mempertimbangkan bas, sahkan sama ada laluan ke destinasi anda beroperasi, hentian, jadual dan tambang pada hari perjalanan.'],
            ['◈', 'Teksi', 'Sahkan ketersediaan teksi, tempat beratur yang dibenarkan serta jumlah tambang sebelum bersetuju untuk bergerak.'],
            ['●', 'E-hailing / tempahan aplikasi', 'Perkhidmatan e-hailing tempatan boleh digunakan jika tersedia. Tetapkan titik ambil yang dibenarkan dan padankan nombor kenderaan/pemandu sebelum masuk.'],
            ['▰', 'Kereta sewa', 'Sesuai jika perjalanan merangkumi beberapa daerah. Semak lesen, perlindungan insurans, polisi bahan api dan peraturan parkir sebelum menerima kenderaan.'],
            ['↔', 'Ke lapangan terbang dari bandar', 'Peruntukkan masa tambahan untuk trafik, pemulangan kereta sewa dan berjalan dari parkir. Untuk penerbangan antarabangsa, utamakan masa daftar masuk syarikat penerbangan.']
          ].map(([icon, heading, copy]) => (
            <article class="rounded-2xl border border-emerald-brunei/12 bg-ivory/92 p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-brunei text-lg font-black text-gold-soft">{icon}</div>
              <h3 class="mt-4 text-lg font-extrabold text-emerald-deep">{heading}</h3>
              <p class="mt-2 text-sm leading-7 text-ink/64">{copy}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="mt-8 rounded-2xl border border-gold-brunei/35 bg-gold-soft/24 p-5 text-sm leading-7 text-ink/68">
        <strong class="text-emerald-deep">Nota perubahan:</strong> jadual bas, tambang teksi, zon e-hailing dan prosedur pengambilan penumpang ialah maklumat yang boleh berubah. Laman ini menerangkan jenis pilihan, bukan menjamin operasi masa nyata.
      </div>
    </div>
  </section>

  <section id="kemudahan" class="section-shell py-20 sm:py-28">
    <div class="grid gap-9 lg:grid-cols-[1fr_0.92fr]">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-emerald-brunei">Kemudahan terminal</p>
        <h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-emerald-deep sm:text-5xl">Apa yang pengguna biasanya mahu tahu</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {facilityCards.map(([heading, copy]) => (
            <article class="rounded-2xl border border-emerald-brunei/12 bg-white/72 p-5">
              <h3 class="font-extrabold text-emerald-deep">{heading}</h3>
              <p class="mt-2 text-sm leading-6 text-ink/63">{copy}</p>
            </article>
          ))}
        </div>
      </div>
      <figure class="relative min-h-[540px] overflow-hidden rounded-[2rem] bg-emerald-deep card-shadow">
        <img src="/images/bwn-departure.webp" width="1400" height="1051" alt="Dewan berlepas Lapangan Terbang Antarabangsa Brunei" loading="lazy" class="h-full w-full object-cover" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/35 to-transparent p-6 pt-28 text-white">
          <h3 class="text-xl font-extrabold">Gunakan papan tanda terminal sebagai sumber terakhir</h3>
          <p class="mt-2 text-sm leading-6 text-white/72">Susun atur, pintu, kaunter dan akses boleh berubah mengikut kerja operasi atau keselamatan.</p>
          <p class="mt-3 text-[11px] text-white/60">Foto rujukan 2018: Newsliner · CC BY-SA 4.0 · <a href="#kredit-imej">Sumber & lesen</a></p>
        </div>
      </figure>
    </div>
  </section>

  <section class="bg-gold-soft/22 py-20 sm:py-24">
    <div class="section-shell">
      <div class="grid gap-8 lg:grid-cols-3">
        <article class="rounded-3xl bg-emerald-deep p-7 text-white">
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-gold-soft">Parkir</p>
          <h2 class="mt-3 text-2xl font-extrabold">Parkir rasmi di kawasan terminal</h2>
          <p class="mt-4 text-sm leading-7 text-white/70">Sahkan lokasi parkir, had tempoh dan kadar semasa dengan pengendali. Ikut tanda serta arahan petugas; panduan ini tidak mengesahkan kapasiti atau ruang berbumbung.</p>
        </article>
        <article class="rounded-3xl border border-emerald-brunei/12 bg-ivory p-7">
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-brunei">Petrol & pengecasan</p>
          <h2 class="mt-3 text-2xl font-extrabold text-emerald-deep">Rancang bahan api sebelum memulangkan kenderaan</h2>
          <p class="mt-4 text-sm leading-7 text-ink/65">Semak lokasi stesen bahan api yang beroperasi pada laluan anda sebelum memulangkan kereta sewa. Kami tidak mengesahkan pengecas EV awam khusus di terminal; semak peta dan penyedia rasmi pada hari perjalanan jika menggunakan kenderaan elektrik.</p>
        </article>
        <article class="rounded-3xl border border-emerald-brunei/12 bg-ivory p-7">
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-brunei">Kecemasan</p>
          <h2 class="mt-3 text-2xl font-extrabold text-emerald-deep">Utamakan petugas dan nombor rasmi</h2>
          <p class="mt-4 text-sm leading-7 text-ink/65">Jabatan Penerbangan Awam menerbitkan talian kecemasan Brunei seperti Ambulans 991, Polis 993 dan Bomba & Penyelamat 995. Untuk isu dalam terminal, hubungi petugas lapangan terbang terlebih dahulu apabila selamat berbuat demikian.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="peta" class="section-shell py-20 sm:py-28">
    <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="overflow-hidden rounded-[2rem] border border-emerald-brunei/10 bg-white card-shadow">
        <iframe
          src={`https://www.google.com/maps?q=${siteInfo.latitude},${siteInfo.longitude}&output=embed`}
          width="100%"
          height="520"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="Peta Google Lapangan Terbang Antarabangsa Brunei"
          class="map-frame block w-full"
        ></iframe>
      </div>
      <div class="rounded-[2rem] bg-emerald-deep p-8 text-white">
        <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-gold-soft">Lokasi</p>
        <h2 class="mt-3 font-display text-4xl font-bold">Bandar Seri Begawan, Negara Brunei Darussalam</h2>
        <dl class="mt-7 space-y-5 text-sm">
          <div><dt class="font-bold text-gold-soft">Alamat</dt><dd class="mt-1 leading-6 text-white/72">{siteInfo.address}</dd></div>
          <div><dt class="font-bold text-gold-soft">Pin Google Maps · 20 Oktober 2026</dt><dd class="mt-1 text-white/72">{siteInfo.latitude.toFixed(7)}, {siteInfo.longitude.toFixed(6)}</dd></div>
          <div><dt class="font-bold text-gold-soft">Hubungan rasmi DCA</dt><dd class="mt-1 text-white/72">{siteInfo.phoneOfficial} · {siteInfo.emailOfficial}</dd></div>
        </dl>
        <p class="mt-4 text-sm leading-7">Google Maps: 4.1/5 daripada 1,394 penilaian pada 20 Oktober 2026. Ini snapshot pihak ketiga, bukan penilaian laman ini. Pin bukan lokasi pintu masuk atau tempat ambil.</p><a class="mt-4 inline-flex min-h-11 items-center underline" href="https://www.dca.gov.bn/flight-information/">Semak ketibaan dan berlepas rasmi DCA</a><p class="mt-7 rounded-2xl border border-white/12 bg-white/6 p-4 text-xs leading-6 text-white/65">Peta pihak ketiga ialah rujukan lokasi. Memuatkan peta menghantar data teknikal seperti alamat IP kepada Google; rujuk Dasar Privasi untuk butiran.</p>
      </div>
    </div>
  </section>

  <section id="sekitar" class="border-y border-emerald-brunei/10 bg-white/50 py-20 sm:py-28">
    <div class="section-shell">
      <div class="max-w-3xl">
        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-emerald-brunei">Selepas keluar dari terminal</p>
        <h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-emerald-deep sm:text-5xl">Makanan, penginapan dan keperluan harian secara neutral</h2>
        <p class="mt-5 text-base leading-8 text-ink/68">Kami sengaja tidak menyenaraikan restoran, hotel atau kedai tertentu. Tujuannya ialah membantu anda mengenal kategori perkhidmatan, kemudian memilih sendiri mengikut bajet, aksesibiliti, diet dan lokasi.</p>
      </div>
      <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Makanan tempatan', 'Cari kategori kedai makan Melayu Brunei, medan selera, sarapan tempatan dan pilihan halal di kawasan bandar. Semak waktu operasi terutamanya pada Ramadan.'],
          ['Penginapan', 'Pilihan lazim merangkumi hotel bandar, hotel perniagaan, apartmen servis dan penginapan bajet. Utamakan akses ke pengangkutan serta polisi daftar masuk lewat.'],
          ['Pasar raya & keperluan', 'Kawasan komersial di sekitar Bandar Seri Begawan/Berakas mempunyai pasar raya, kedai serbaneka dan farmasi. Pilih berdasarkan laluan perjalanan, bukan iklan.'],
          ['Perkhidmatan perjalanan', 'Untuk SIM/data, wang tunai, bagasi dan keperluan perjalanan, semak kategori perkhidmatan di terminal atau pusat komersial tanpa bergantung pada satu vendor.']
        ].map(([heading, copy]) => (
          <article class="rounded-2xl border border-emerald-brunei/12 bg-ivory p-6">
            <h3 class="text-lg font-extrabold text-emerald-deep">{heading}</h3>
            <p class="mt-3 text-sm leading-7 text-ink/64">{copy}</p>
          </article>
        ))}
      </div>

      <div class="mt-16 grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-emerald-brunei">Calon lawatan bandar</p>
          <h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-emerald-deep">Kenali ibu negara selepas ketibaan</h2>
          <p class="mt-5 text-sm leading-7 text-ink/63">Nama berikut ialah calon perjalanan berasingan, bukan perkhidmatan di terminal atau lawatan yang disahkan dalam semakan ini. Semak lokasi, jarak, akses dan waktu setiap destinasi sendiri.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {nearbyAttractions.map(([heading, copy], index) => (
            <article class:list={["rounded-2xl p-6", index === 0 ? "bg-emerald-deep text-white" : "border border-emerald-brunei/12 bg-ivory"]}>
              <p class:list={["text-[11px] font-black uppercase tracking-[0.18em]", index === 0 ? "text-gold-soft" : "text-emerald-brunei/55"]}>Singgahan {String(index + 1).padStart(2, '0')}</p>
              <h3 class:list={["mt-2 text-lg font-extrabold", index === 0 ? "text-white" : "text-emerald-deep"]}>{heading}</h3>
              <p class:list={["mt-2 text-sm leading-7", index === 0 ? "text-white/68" : "text-ink/64"]}>{copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell py-20 sm:py-28">
    <div class="grid gap-8 lg:grid-cols-[1fr_1fr]">
      <figure class="relative min-h-[440px] overflow-hidden rounded-[2rem] bg-emerald-deep card-shadow">
        <img src="/images/bwn-surau.webp" width="1400" height="1051" alt="Surau di kawasan Lapangan Terbang Antarabangsa Brunei" loading="lazy" class="h-full w-full object-cover" />
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-6 pt-24 text-xs text-white/70">Ruang ibadah mencerminkan konteks masyarakat Brunei. Foto rujukan 2021: zulfadli · CC BY-SA 4.0 · <a href="#kredit-imej">Sumber & lesen</a></figcaption>
      </figure>
      <div class="flex flex-col justify-center rounded-[2rem] border border-emerald-brunei/12 bg-white/64 p-8 sm:p-10">
        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-emerald-brunei">Nota budaya</p>
        <h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-emerald-deep">Ruang ibadah bukan dekorasi — ia sebahagian daripada ritma tempat</h2>
        <p class="mt-5 text-base leading-8 text-ink/68">Di Brunei, ruang solat dan adab sekitar waktu ibadah ialah sebahagian daripada pengalaman harian. Pelawat disaran menjaga suara, mengikuti tanda pemisahan ruang jika ada dan menghormati pengguna yang sedang beribadah.</p>
        <p class="mt-4 text-sm leading-7 text-ink/58">Untuk lawatan ke masjid selepas meninggalkan lapangan terbang, semak waktu bukan solat untuk pelawat, peraturan pakaian dan kawasan yang dibenarkan. Jangan menganggap semua ruang keagamaan mempunyai aturan lawatan yang sama.</p>
      </div>
    </div>
  </section>

  <section id="faq" class="bg-emerald-deep py-20 text-white sm:py-28">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.66fr_1.34fr]">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-gold-soft">Soalan lazim</p>
        <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">Jawapan ringkas, dengan had maklumat yang jelas</h2>
        <p class="mt-5 text-sm leading-7 text-white/65">Jika jawapan berkaitan penerbangan hari ini, visa, imigresen atau keselamatan, rujuk pihak rasmi; laman ini bukan sistem operasi lapangan terbang.</p>
      </div>
      <div class="space-y-3">
        {faqItems.map((item) => (
          <details class="group rounded-2xl border border-white/12 bg-white/6 p-5 open:bg-white/9">
            <summary class="cursor-pointer list-none pr-8 text-base font-extrabold marker:hidden">{item.q}<span class="float-right text-gold-soft transition group-open:rotate-45">＋</span></summary>
            <p class="mt-4 border-t border-white/10 pt-4 text-sm leading-7 text-white/68">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-20 sm:py-24">
    <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr]">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-emerald-brunei">Sumber & metodologi</p>
        <h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-emerald-deep">Bagaimana panduan ini dibina</h2>
        <p class="mt-5 text-sm leading-7 text-ink/64">Fakta teras dirujuk kepada DCA; lokasi dan penilaian Maps ialah snapshot pada 20 Oktober 2026. Maklumat yang mudah berubah ditulis sebagai panduan kategori dan disertakan arahan untuk mengesahkannya semula.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {officialSources.map((source, index) => (
          <a href={source.href} target="_blank" rel="noreferrer" class="group rounded-2xl border border-emerald-brunei/12 bg-white/70 p-5 no-underline hover:border-gold-brunei/70">
            <span class="text-[11px] font-black uppercase tracking-[0.16em] text-emerald-brunei/55">Sumber rasmi {String(index + 1).padStart(2, '0')}</span>
            <strong class="mt-3 block text-sm leading-6 text-emerald-deep group-hover:text-emerald-brunei">{source.label}</strong>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-12 rounded-3xl border border-emerald-brunei/12 bg-white/64 p-7">
      <h2 id="kredit-imej" class="text-lg font-extrabold text-emerald-deep">Kredit imej</h2>
      <div class="mt-4 grid gap-4 text-xs leading-6 text-ink/60 sm:grid-cols-2">
        <p><strong>Pangalau</strong> — <a href="https://commons.wikimedia.org/wiki/File:Bandar_Seri_Begawan_25_October_2023_02.jpg">Sumber foto</a>, 25 Oktober 2023. <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Versi diperkecil dan dikodkan semula; potongan paparan mungkin berbeza.</p>
        <p><strong>Iqbal Selamat</strong> — <a href="https://commons.wikimedia.org/wiki/File:Brunei_International_Airport_at_sunset.jpg">Brunei International Airport at sunset</a>, 14 Jun 2018. <a href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a>. Versi diperkecil dan dikodkan semula; potongan paparan mungkin berbeza.</p>
        <p><strong>Newsliner</strong> — <a href="https://commons.wikimedia.org/wiki/File:Brunei_international_airport_departure_hall.jpg">Sumber foto</a>, 27 Mei 2018. <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Versi diperkecil dan dikodkan semula; potongan paparan mungkin berbeza.</p>
        <p><strong>zulfadli</strong> — <a href="https://commons.wikimedia.org/wiki/File:Brunei_International_Airport_Surau_2.jpg">Sumber foto</a>, 27 Julai 2021. <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Versi diperkecil dan dikodkan semula; potongan paparan mungkin berbeza.</p>
      </div>
      <p class="mt-5 text-xs leading-6 text-ink/52">Foto arkib rujukan dari 2018–2023 tidak mengesahkan susun atur atau akses hari ini. Penggunaan gambar tidak menunjukkan sokongan jurugambar terhadap laman ini.</p>
    </div>
  </section>
</BaseLayout>
